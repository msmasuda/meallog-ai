# Copy this file to .env and edit it for your environment.
# For a physical device, replace localhost with the agent Mac's LAN IP/hostname.
AGENT_API_BASE_URL=http://localhost:8000

# Optional: temporary development token. Values are embedded in the app binary.
AGENT_API_ACCESS_TOKEN=

# Optional: leave empty to use the agent's default vision model.
AGENT_VISION_MODEL=
